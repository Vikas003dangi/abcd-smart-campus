# ==============================================================================
# ABCD COACHING & LIBRARY MANAGEMENT PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' inside 'abcd_web/' and fill in your actual credentials.
# NEVER commit your actual '.env' file with real secrets to GitHub or public repos!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-this-to-a-super-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,abcd2013.online,www.abcd2013.online,*.onrender.com,*.railway.app
CSRF_TRUSTED_ORIGINS=https://abcd2013.online,https://www.abcd2013.online,http://127.0.0.1:8000,http://localhost:8000
SITE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# In local development, leave DATABASE_URL empty to use SQLite (db.sqlite3).
# In production (e.g. Render, Railway, AWS RDS), supply your PostgreSQL connection string:
# DATABASE_URL=postgres://username:password@hostname:5432/database_name
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. REDIS CHANNEL LAYER (OPTIONAL FOR WEBSOCKETS / GUIDY CHAT)
# ------------------------------------------------------------------------------
# In distributed multi-worker production environments, supply your Redis URL:
# REDIS_URL=redis://default:password@hostname:6379/0
REDIS_URL=

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (SMTP / GMAIL)
# ------------------------------------------------------------------------------
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH2 SOCIAL LOGIN
# ------------------------------------------------------------------------------
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-oauth-client-id.apps.googleusercontent.com
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# 6. META WHATSAPP BUSINESS CLOUD API
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN=your_meta_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# ------------------------------------------------------------------------------
# 7. SMS GATEWAY (e.g. Fast2SMS / Twilio)
# ------------------------------------------------------------------------------
SMS_API_KEY=your_sms_gateway_api_key

# ------------------------------------------------------------------------------
# 8. YOUTUBE DATA API V3
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_data_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# ------------------------------------------------------------------------------
# 9. WEB PUSH NOTIFICATIONS (VAPID KEYS)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key_string
VAPID_PRIVATE_KEY=your_vapid_private_key_string
