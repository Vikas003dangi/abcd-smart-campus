{
  "name": "ABCD Coaching & Library",
  "short_name": "ABCD Campus",
  "id": "/",
  "scope": "/",
  "start_url": "/",
  "description": "ABCD Coaching & Library Smart Campus Platform",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "icons": [
    {
      "src": "/static/data/favicon/favicon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/data/favicon/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/data/favicon/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "theme_color": "#e09fd5",
  "background_color": "#854c7a",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+abcd",
      "url": "/?pwa_app=1&launch=%s"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "in.abcdcampus.app",
      "url": "https://play.google.com/store/apps/details?id=in.abcdcampus.app"
    },
    {
      "platform": "webapp",
      "url": "/static/data/favicon/site.webmanifest",
      "id": "/"
    }
  ]
}